# systemd unit for the Slipstream server binary.
#
# Standalone (directory + relay on port 8080):
#   sudo useradd --system --home /var/lib/slipstream slipstream
#   sudo install -Dm755 slipstream-server /usr/local/bin/slipstream-server
#   sudo cp slipstream-server.service /etc/systemd/system/
#   sudo systemctl enable --now slipstream-server
#
# Relay next to the PHP directory (behind Apache/Nginx on the same domain):
#   sudo systemctl edit slipstream-server   and set
#     Environment=SLIPSTREAM_LISTEN=127.0.0.1:21117
#     Environment=SLIPSTREAM_ARGS=--relay-only
[Unit]
Description=Slipstream Remote directory and relay
After=network-online.target
Wants=network-online.target

[Service]
User=slipstream
Environment=SLIPSTREAM_DATA=/var/lib/slipstream
Environment=SLIPSTREAM_LISTEN=[::]:8080
Environment=SLIPSTREAM_ARGS=
ExecStart=/usr/local/bin/slipstream-server $SLIPSTREAM_ARGS
StateDirectory=slipstream
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

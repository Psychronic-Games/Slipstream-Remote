// Windows resources for slipstream.exe: icon and version information.
// SLIP_VER (1,2,3,build) and SLIP_VER_STR ("1.2.3") come from Cargo.toml
// and git, through apps/slipstream/build.rs.
1 ICON "slipstream.ico"
1 24 "slipstream.manifest"

1 VERSIONINFO
FILEVERSION SLIP_VER
PRODUCTVERSION SLIP_VER
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Slipstream Remote contributors"
      VALUE "FileDescription", "Slipstream Remote"
      VALUE "ProductName", "Slipstream Remote"
      VALUE "FileVersion", SLIP_VER_STR
      VALUE "ProductVersion", SLIP_VER_STR
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "slipstream.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
